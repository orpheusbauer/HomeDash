# Core server
NODE_ENV=development
HOMEDASH_HOST=0.0.0.0
HOMEDASH_PORT=4100
HOMEDASH_DATABASE_PATH=./data/homedash.db
HOMEDASH_PUBLIC_URL=http://localhost:5173
HOMEDASH_TIMEZONE=Europe/Paris

# Four-digit PIN entered in the dashboard. The requested default is 0000.
HOMEDASH_ADMIN_PIN=0000

# Generate long random values for machine-to-machine secrets.
HOMEDASH_SENSOR_INGEST_TOKEN=change-me-with-a-second-random-token
HOMEDASH_ENCRYPTION_KEY=

# GitHub releases (token file needed only for a private repository)
HOMEDASH_GITHUB_REPOSITORY=orpheusbauer/HomeDash
HOMEDASH_GITHUB_TOKEN_FILE=

# Resource tuning
HOMEDASH_SYSTEM_METRICS_INTERVAL_MS=10000
HOMEDASH_ENABLE_MOCK_SENSORS=false

# Legacy Docker updater; left empty on the Raspberry Pi Zero native target.
HOMEDASH_UPDATER_SOCKET=/run/homedash-updater/updater.sock
HOMEDASH_UPDATER_TOKEN=
HOMEDASH_UPDATER_TOKEN_FILE=

# Google Calendar (optional)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Web development proxy
VITE_API_URL=http://localhost:4100
