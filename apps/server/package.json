{
  "name": "@homedash/server",
  "version": "0.4.10",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed"
  },
  "dependencies": {
    "@fastify/cors": "*",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "*",
    "@fastify/static": "^10.1.4",
    "@fastify/websocket": "^11.3.1",
    "@homedash/contracts": "0.4.10",
    "drizzle-orm": "*",
    "fastify": "^5.12.5",
    "pino-pretty": "*",
    "ws": "*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "*",
    "@types/ws": "*",
    "tsx": "^4.23.14",
    "typescript": "*"
  }
}
