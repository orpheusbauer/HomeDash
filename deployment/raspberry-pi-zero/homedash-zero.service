[Unit]
Description=HomeDash native service for Raspberry Pi Zero
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/homedash/current/apps/server/dist/index.js
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=homedash
Group=homedash
WorkingDirectory=/opt/homedash/current
EnvironmentFile=/etc/homedash/homedash.env
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=192
ExecStart=/usr/local/bin/node apps/server/dist/index.js
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
KillSignal=SIGTERM
LimitCORE=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=homedash
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/homedash/data
UMask=0007
MemoryHigh=320M
MemoryMax=400M
TasksMax=64

[Install]
WantedBy=multi-user.target
