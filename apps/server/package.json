{
  "name": "@homedash/server",
  "version": "0.4.11",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed"
  },
  "dependencies": {
    "@fastify/cors": "*",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "*",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.1",
    "@homedash/contracts": "0.4.11",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pino-pretty": "*",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "*",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "*"
  }
}
